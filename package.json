{
  "name": "jobtrace-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check . && node scripts/check-deps.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-sites": "pnpm --filter @jobtrace/test-sites start",
    "jobtrace": "node apps/cli/bin/jobtrace.js",
    "db:migrate": "node apps/cli/bin/jobtrace.js db migrate",
    "dev:web": "pnpm --filter @jobtrace/web dev",
    "build:web": "pnpm --filter @jobtrace/web build",
    "dev": "node apps/cli/bin/jobtrace.js serve & pnpm --filter @jobtrace/web dev",
    "test:e2e": "pnpm build:web && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
